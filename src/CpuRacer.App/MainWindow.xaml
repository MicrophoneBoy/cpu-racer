<Window x:Class="CpuRacer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CpuRacer.App"
        mc:Ignorable="d"
        Title="CPU Racer" Height="650" Width="1000"
        Background="#FF1B1B1B" Foreground="#FFE6E6E6"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="SidebarBg" Color="#FF202020"/>
        <SolidColorBrush x:Key="TileHoverBg" Color="#FF2B2B2B"/>
        <SolidColorBrush x:Key="TileSelectedBg" Color="#FF323232"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF00B7C3"/>
        <SolidColorBrush x:Key="GridLineBrush" Color="#FF3A3A3A"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#FF9A9A9A"/>

        <Style x:Key="SidebarTile" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource TileHoverBg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}">
            <StackPanel>
                <TextBlock Text="Performance" Margin="14,14,0,10" FontSize="13" Foreground="{StaticResource MutedTextBrush}"/>

                <!-- Selected: CPU -->
                <Border Style="{StaticResource SidebarTile}" Background="{StaticResource TileSelectedBg}">
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#FF00B7C3"/>
                    </Border.BorderBrush>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="{StaticResource AccentBrush}" Margin="-12,-8,0,-8"/>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="CPU" FontSize="12"/>
                            <TextBlock x:Name="CpuTileValueText" Text="0%" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,4"/>
                            <Polyline x:Name="CpuTileSparkline" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.2" Height="28" Stretch="Fill"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Placeholder tiles for the other metrics (wired up later) -->
                <Border Style="{StaticResource SidebarTile}">
                    <StackPanel>
                        <TextBlock Text="Memory" FontSize="12"/>
                        <TextBlock Text="-- GB" FontSize="18" Margin="0,2,0,0" Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SidebarTile}">
                    <StackPanel>
                        <TextBlock Text="Disk 0 (C:)" FontSize="12"/>
                        <TextBlock Text="-- %" FontSize="18" Margin="0,2,0,0" Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SidebarTile}">
                    <StackPanel>
                        <TextBlock Text="Wi-Fi" FontSize="12"/>
                        <TextBlock Text="-- Mbps" FontSize="18" Margin="0,2,0,0" Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SidebarTile}">
                    <StackPanel>
                        <TextBlock Text="GPU 0" FontSize="12"/>
                        <TextBlock Text="-- %" FontSize="18" Margin="0,2,0,0" Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1" Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="CPU" FontSize="26" FontWeight="Light"/>
            <TextBlock Grid.Row="1" x:Name="ProcessorNameText" Text="—" FontSize="13" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,14"/>

            <!-- Big graph -->
            <Border Grid.Row="2" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="1" Background="#FF141414">
                <Grid x:Name="GraphGrid" ClipToBounds="True">
                    <!-- Horizontal gridlines drawn in code-behind -->
                    <Canvas x:Name="GridLinesCanvas"/>
                    <Polyline x:Name="CpuGraphLine" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6" Stretch="None"/>
                    <Canvas x:Name="CoinLayer"/>
                    <Canvas x:Name="CarLayer"/>
                    <TextBlock Text="100%" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="6,4,0,0"/>
                    <TextBlock Text="0%" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="6,0,0,4" VerticalAlignment="Bottom"/>

                    <TextBlock x:Name="DistanceHudText" Text="0.0m  best 0.0m" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0"/>

                    <TextBlock x:Name="ScoreHudText" Text="Score 0  best 0" FontSize="13" Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,30,10,0"/>

                    <Canvas x:Name="ThrottleGauge"/>

                    <TextBlock x:Name="StatusHudText" Text="" FontSize="20" FontWeight="Bold" Foreground="#FFFF6B6B"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Stat grid -->
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                    <TextBlock Text="Utilization" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock x:Name="UtilizationText" Text="0%" FontSize="16"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                    <TextBlock Text="Speed" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock x:Name="SpeedText" Text="—" FontSize="16"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock Text="Cores" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock x:Name="CoresText" Text="—" FontSize="16"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,10">
                    <TextBlock Text="Logical processors" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock x:Name="LogicalProcessorsText" Text="—" FontSize="16"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0">
                    <TextBlock Text="Up time" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock x:Name="UpTimeText" Text="—" FontSize="16"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1">
                    <TextBlock Text="Score" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock x:Name="ScoreText" Text="0" FontSize="16"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2">
                    <TextBlock Text="Coins" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock x:Name="CoinsText" Text="0" FontSize="16"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="3">
                    <TextBlock Text="Best score" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock x:Name="BestScoreText" Text="0" FontSize="16"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
